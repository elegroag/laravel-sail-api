###############################################################################
#                    APLICACIÓN - Configuración General                        #
###############################################################################
# Nombre visible de la aplicación.
APP_NAME=ComfacaEnLinea

# Entorno de ejecución: local | production | testing | staging
APP_ENV=local

# Usuario y grupo del proceso web (PHP-FPM/Apache) en entorno Docker/Linux.
WWWGROUP=1000
WWWUSER=1000

# Clave de cifrado de Laravel. Generar con: php artisan key:generate
# NUNCA commitear una clave real al repositorio.
APP_KEY=

# Modo depuración: true en local, false en producción.
APP_DEBUG=true

# Puerto HTTP expuesto por el contenedor/servidor.
APP_PORT=9043

# URL pública principal usada por la app (enlaces, emails, Swagger, etc.).
APP_URL="http://localhost"

# Dominio raíz (alternativo al APP_URL, usado en algunos componentes).
APP_DOMINIO="http://localhost"

# Modo lógico de operación de la app: development | production
APP_MODE="development"

###############################################################################
#                     LOGGING - Sistema de Registros                           #
###############################################################################
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null

# Niveles: debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

###############################################################################
#                       DATABASE - Conexión MySQL                             #
###############################################################################
DB_CONNECTION=mysql
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="mercurio_dev"
DB_USERNAME="root"
DB_PASSWORD=""

###############################################################################
#          CACHE / BROADCAST / QUEUE / FILESYSTEM - Drivers                   #
###############################################################################
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

###############################################################################
#                       SESSION - Manejo de Sesiones                          #
###############################################################################
# Driver: database | file | cookie | redis
SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions

# Tiempo de vida en minutos (4320 = 3 días).
SESSION_LIFETIME=4320
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE="comfaca_session_v2"
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

###############################################################################
#                  CACHE BACKENDS - Memcached / Redis                         #
###############################################################################
# Descomentar y rellenar si se usa Memcached.
MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
#                          MAIL - Configuración SMTP                          #
###############################################################################
# Mailer: smtp | sendmail | mailgun | postmark | log | array
MAIL_MAILER=smtp
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USERNAME="your-mail-username"
MAIL_PASSWORD="your-mail-password"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=30
MAIL_DEV=""

###############################################################################
#                  AWS / S3 - Almacenamiento en la Nube                       #
###############################################################################
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="your-bucket-name"
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
#              PUSHER - Broadcasting / WebSockets en tiempo real              #
###############################################################################
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_APP_KEY="your-pusher-app-key"
PUSHER_APP_SECRET="your-pusher-app-secret"
PUSHER_HOST="your-pusher-host"
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

###############################################################################
#            VITE / INERTIA - Build y Server-Side Rendering                   #
###############################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# URL del servidor SSR de Inertia. Activar con: php artisan inertia:start-ssr
INERTIA_SSR_URL="http://localhost:${VITE_PORT}"
INERTIA_SSR_ENABLED=false

###############################################################################
#               API INTEGRATION - Portal y Host API externo                   #
###############################################################################
# API_MODE define el ambiente lógico de las APIs: development | production
API_MODE="development"

# URLs del portal principal (Mercurio) según ambiente.
HOST_PORTAL_DEV="http://localhost:8000"
HOST_PORTAL_PRO="https://example.com"

# Identificador y clave del portal para handshake con APIs externas.
PORTAL="Portal_Mercurio"
PORTAL_KEY="your-portal-key"

# Credenciales para consumir las APIs del HOST (usuario/clave).
HOST_API_USER="2"
HOST_API_PASSWORD="your-host-api-password"

# Endpoints base del HOST API por ambiente.
HOST_API_DEV="http://localhost:9000/api"
HOST_API_PRO="https://example.com:9000/api"

# Algoritmo de cifrado usado para payloads firmados.
API_ENCRYPTION="AES-256-CBC"

# Habilitar uso de comandos CLI en flujos del portal.
USE_CLI=false

# Bandera de integración con sistemas externos.
APP_INTEGRATION=false

###############################################################################
#                    JWT - Autenticación del portal Mercurio                  #
###############################################################################
# Clave secreta de tokens JWT. Generar con: php artisan jwt:secret
JWT_SECRET="your-jwt-secret-key"

# TTL en minutos (30 = 30 min). Tiempo de refresco en minutos (10080 = 7 días).
JWT_TTL=30
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

###############################################################################
#                  APIS EXTERNAS - WhatsApp y Flask                           #
###############################################################################
# API WhatsApp: credenciales del servicio de notificaciones.
API_WHATSAPP_USER="your-whatsapp-user"
API_WHATSAPP_PASSWORD="your-whatsapp-password"

# API Flask: credenciales del microservicio Python (validaciones, etc).
API_FLASK_USER="your-flask-user"
API_FLASK_PASSWORD="your-flask-password"

###############################################################################
#                  SWAGGER - Documentación interactiva de APIs                #
###############################################################################
L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
L5_SWAGGER_UI_FILTERS=true
L5_SWAGGER_UI_DOC_EXPANSION='none'
L5_SWAGGER_OPERATIONS_SORT=
L5_SWAGGER_GENERATE_YAML_COPY=false
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_SWAGGER_UI_ASSETS_PATH='vendor/swagger-api/swagger-ui/dist/'
L5_FORMAT_TO_USE_FOR_DOCS='json'
L5_SWAGGER_BASE_PATH=
SWAGGER_DEBUG=true

###############################################################################
#                  SFTP CLISISU - Integración con Clisisu                     #
###############################################################################
SFTP_SISU_HOST="sftp.example.com"
SFTP_SISU_USERNAME="your-sftp-user"
SFTP_SISU_PASSWORD="your-sftp-password"
SFTP_SISU_PORT=22
SFTP_SISU_TIMEOUT=60
SFTP_SISU_PRIVATE_KEY=
SFTP_SISU_PRIVATE_KEY_PASSPHRASE=
SFTP_SISU_STORAGE=""

###############################################################################
#                  SFTP NEW SUBSIDIO - Integración con Subsidio               #
###############################################################################
SFTP_SYS_HOST="sftp.example.com"
SFTP_SYS_USERNAME="your-sftp-user"
SFTP_SYS_PASSWORD="your-sftp-password"
SFTP_SYS_PORT=22
SFTP_SYS_TIMEOUT=60
SFTP_SYS_PRIVATE_KEY=
SFTP_SYS_PRIVATE_KEY_PASSPHRASE=
SFTP_SYS_STORAGE=""

###############################################################################
#                   CAPTCHA - Login del entorno Cajas                         #
###############################################################################
CAPTCHA_LENGTH=5
CAPTCHA_TTL_MINUTES=5
CAPTCHA_NOISE_LEVEL=medium
CAPTCHA_USE_TTF=true
CAPTCHA_TTF_PATH=
CAPTCHA_WIDTH=140
CAPTCHA_HEIGHT=44

###############################################################################
#                  EPAYCO - Pasarela de pagos (Checkout)                      #
###############################################################################
# Ambiente EPAYCO: development | production
EPAYCO_MODE="development"

# Llaves de API Rest + Onpage Checkout + Standart Checkout.
EPAYCO_PUBLIC_KEY="your-epayco-public-key"
EPAYCO_PRIVATE_KEY="your-epayco-private-key"
EPAYCO_CHECKOUT_VERSION="2"

# Llaves secretas adicionales (cliente/criptografía).
EPAYCO_P_KEY="your-epayco-p-key"
EPAYCO_P_CUST_ID_CLIENTE="your-epayco-cust-id"

###############################################################################
#              GOOGLE RECAPTCHA - Protección de formularios web                #
###############################################################################
CAPTCHA_GOOGLE_SITE_KEY="your-google-site-key"
CAPTCHA_GOOGLE_SECRET_KEY="your-google-secret-key"

###############################################################################
#                       MAINTENANCE - Modo Mantenimiento                      #
###############################################################################
# Bloquea el acceso a usuarios finales cuando es true.
APP_MAINTENANCE_ENDUSERS=false

# Driver de mantenimiento: file | cache
APP_MAINTENANCE_DRIVER="file"

# Almacén del flag de mantenimiento: database | file | array
APP_MAINTENANCE_STORE="database"
